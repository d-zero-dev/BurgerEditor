{
	"private": true,
	"type": "module",
	"license": "(MIT OR Apache-2.0)",
	"repository": {
		"type": "git",
		"url": "https://github.com/d-zero-dev/BurgerEditor.git"
	},
	"scripts": {
		"start": "cd ./packages/@burger-editor/local && node ./server/index.js",
		"bge": "yarn start",
		"build": "lerna run build",
		"clean": "lerna run clean",
		"dev": "lerna run dev --parallel",
		"storybook": "yarn workspace @burger-editor/storybook dev",
		"build-storybook": "yarn workspace @burger-editor/storybook build",
		"test": "bash scripts/docker-yarn.sh test:unit",
		"test:unit": "node scripts/run-vitest-groups.mjs",
		"test:no-compiler": "bash scripts/docker-yarn.sh test:no-compiler:unit",
		"test:no-compiler:unit": "node scripts/run-vitest-groups.mjs --project client --project blocks --project blocks-editor",
		"test:vr": "vitest run --project vr",
		"test:vr:update": "vitest run --project vr --update",
		"test:vr:docker": "bash scripts/docker-yarn.sh test:vr",
		"test:vr:docker:update": "bash scripts/docker-yarn.sh test:vr --update",
		"verify:architecture-graph": "node scripts/check-architecture-graph.mjs",
		"verify:react-compiler": "node scripts/check-react-compiler-coverage.mjs",
		"verify:blocks-boundary": "node scripts/check-blocks-entry-boundary.mjs",
		"verify:packed-install": "node scripts/verify-packed-install.mjs",
		"lint": "run-s lint:eslint lint:stylelint lint:markuplint lint:prettier lint:textlint:fix lint:textlint:check lint:cspell lint:renovate",
		"lint:renovate": "RENOVATE_X_IGNORE_RE2=true renovate-config-validator --strict",
		"lint:cspell": "npx cspell --no-progress --show-suggestions \"{*,**/*}/\"",
		"lint:eslint": "npx eslint --fix \"{*,**/*}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}\"",
		"lint:stylelint": "npx stylelint \"./packages/@burger-editor/*/{src,style}/**/*.{css,scss,sass}\" --fix",
		"lint:prettier": "npx prettier --write \"{*,**/*}.{md,json,js,cjs,mjs,jsx,ts,cts,mts,tsx}\"",
		"lint:markuplint": "npx markuplint \"./packages/@burger-editor/**/*.{html,tsx}\"",
		"lint:textlint:fix": "npx textlint --fix \"{*,**/*}.md\"",
		"lint:textlint:check": "npx textlint \"{*,**/*}.md\"",
		"prepare": "husky",
		"commit": "npx cz",
		"co": "npx cz",
		"update": "yarn upgrade-interactive"
	},
	"workspaces": [
		"packages/@burger-editor/*"
	],
	"resolutions": {
		"@burger-editor/mcp-server/zod": "4.6.7",
		"css-tree": "3.2.1",
		"nx/undici": "8.13.1",
		"prosemirror-model": "1.25.13",
		"prosemirror-transform": "1.12.7",
		"prosemirror-view": "1.44.0"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-customizable"
		},
		"cz-customizable": {
			"config": "./node_modules/@d-zero/cz-config"
		}
	},
	"devDependencies": {
		"@d-zero/commitlint-config": "5.1.1",
		"@d-zero/cspell-config": "5.1.1",
		"@d-zero/eslint-config": "5.1.3",
		"@d-zero/lint-staged-config": "5.1.1",
		"@d-zero/markuplint-config": "5.1.3",
		"@d-zero/prettier-config": "5.1.1",
		"@d-zero/release-automation": "0.1.0",
		"@d-zero/stylelint-config": "5.1.1",
		"@d-zero/textlint-config": "5.1.2",
		"@d-zero/tsconfig": "2.0.0",
		"@markuplint/jsx-parser": "4.18.4",
		"@markuplint/react-spec": "5.6.1",
		"@vitest/browser": "5.1.2",
		"@vitest/browser-playwright": "5.1.2",
		"eslint-plugin-react-hooks": "7.1.1",
		"husky": "9.1.7",
		"jsdom": "28.1.0",
		"lerna": "10.1.3",
		"markuplint": "4.18.5",
		"npm-run-all2": "9.1.0",
		"pixelmatch": "8.0.0",
		"playwright": "1.65.1",
		"pngjs": "7.0.0",
		"renovate": "44.262.1",
		"typescript": "5.9.3",
		"vitest": "5.1.2"
	},
	"packageManager": "yarn@4.19.0",
	"volta": {
		"node": "26.13.1",
		"yarn": "4.19.0"
	}
}
