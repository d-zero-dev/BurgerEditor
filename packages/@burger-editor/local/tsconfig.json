{
	"extends": ["../../../tsconfig.json"],
	"compilerOptions": {
		"noEmit": true,
		"target": "ESNext",
		"module": "NodeNext",
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx"
	},
	// 依存のうち blocks は noEmit（TS6310）、client は composite でない（TS6306）ため参照できない
	"references": [
		{
			"path": "../cli"
		},
		{
			"path": "../inspector"
		},
		{
			"path": "../core"
		},
		{
			"path": "../file-io"
		}
	]
}
