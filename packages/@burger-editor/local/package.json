{
	"name": "@burger-editor/local",
	"version": "4.0.0-alpha.71",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/d-zero-dev/BurgerEditor.git",
		"directory": "packages/@burger-editor/local"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./server/types.d.ts"
		},
		"./import": {
			"import": "./import/index.js",
			"types": "./import/index.d.ts"
		},
		"./get-user-config": {
			"import": "./server/model/get-user-config.js",
			"types": "./server/model/get-user-config.d.ts"
		},
		"./create-health-checker": {
			"import": "./server/create-health-checker.js",
			"types": "./server/create-health-checker.d.ts"
		},
		"./get-candidate-name": {
			"import": "./server/helpers/get-candidate-name.js",
			"types": "./server/helpers/get-candidate-name.d.ts"
		},
		"./upload": {
			"import": "./server/helpers/upload.js",
			"types": "./server/helpers/upload.d.ts"
		}
	},
	"bin": {
		"bge": "./server/index.js"
	},
	"files": [
		"dist",
		"import",
		"server",
		"style"
	],
	"scripts": {
		"build": "npx run-p build:check build:client build:import build:server",
		"build:client": "vite build",
		"build:import": "npx tsc -p tsconfig.import.build.json",
		"build:server": "npx tsc -p tsconfig.build.json",
		"build:check": "npx tsc",
		"dev": "npx run-p dev:client dev:server",
		"dev:client": "vite build --watch",
		"dev:server": "DEV_MODE=true DEBUG=\"@bge:*\" tsx watch src/index.ts"
	},
	"dependencies": {
		"@burger-editor/blocks": "4.0.0-alpha.71",
		"@burger-editor/core": "4.0.0-alpha.71",
		"@burger-editor/file-io": "4.0.0-alpha.71",
		"@burger-editor/inspector": "4.0.0-alpha.71",
		"@hono/node-server": "2.1.0",
		"@hono/zod-validator": "0.9.0",
		"ansi-colors": "4.1.3",
		"debug": "4.4.3",
		"hono": "4.13.1",
		"open": "11.0.0",
		"prettier": "3.9.6",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@burger-editor/client": "4.0.0-alpha.71",
		"@d-zero/shared": "0.23.0",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/debug": "4.1.13",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"dotenv": "17.4.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tsx": "4.23.11",
		"vite": "7.3.6",
		"vitest": "4.1.10"
	},
	"author": "D-ZERO",
	"license": "(MIT OR Apache-2.0)"
}
