{
	"import": ["@d-zero/cspell-config"],
	"ignorePaths": [".vscode", ".claude", "**/CODEOWNERS", "**/storybook-static/**"],
	"words": [
		// CSS terminology
		"CSSWG",
		"unlayered",

		// Lowercased
		"closedby",
		"nocheck",
		"vbscript",
		"xlarge",

		// Shell keywords
		"elif",

		// English vocabulary missing from the base dictionary
		"unrepresentable",

		// Dependencies
		"hono",
		"pixelmatch",
		"pngjs",
		"jaco",
		"tabler",
		"trix",

		// Project specific
		"bgeconfig",

		// Networking terminology (WebSocket ack/nack protocol)
		"acked",
		"acking",
		"acks",
		"nack",
		"nacked",
		"nacking",
		"nacks",

		// Vitest API (vi.unstubAllGlobals)
		"unstub",

		// GitHub Security Advisory IDs (e.g. GHSA-4v47-5hm4-93xf)
		"GHSA"
	]
}
