{
	"import": ["@d-zero/cspell-config"],
	"ignorePaths": [
		".vscode",
		".claude",
		".agents",
		"**/CODEOWNERS",
		"**/storybook-static/**"
	],
	"words": [
		// CSS terminology
		"CSSWG",
		"unlayered",

		// Accessibility
		"WCAG",

		// Lowercased
		"attributionsrc",
		"closedby",
		"nocheck",
		"vbscript",
		"xlarge",

		// Shell keywords
		"elif",

		// English vocabulary missing from the base dictionary
		"unrepresentable",
		"uncompiled",

		// Dependencies
		"hono",
		"honojs",
		"pixelmatch",
		"pngjs",
		"jaco",
		"tabler",
		"trix",

		// Project specific
		"bgeconfig",
		// ARCHITECTURE.md mermaid node ID for mcp-server (hyphens stripped)
		"mcpserver",

		// Networking terminology (WebSocket ack/nack protocol)
		"acked",
		"acking",
		"acks",
		"nack",
		"nacked",
		"nacking",
		"nacks",

		// Vitest API (vi.unstubAllGlobals)
		"unstub",

		// HTML / SVG / MathML terms used by the sanitizer and its tests
		"mglyph",
		"RCDATA",
		"SMIL",

		// GitHub Security Advisory IDs (e.g. GHSA-4v47-5hm4-93xf)
		"GHSA"
	]
}
