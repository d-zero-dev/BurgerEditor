FROM mcr.microsoft.com/playwright:v1.65.0-noble

ARG NODE_VERSION

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates fonts-noto-cjk \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL https://mise.run | sh

ENV PATH=/root/.local/bin:/root/.local/share/mise/shims:$PATH

# Node 25 and later do not ship Corepack, so it is installed from npm at a
# pinned version (read by a custom manager in renovate.json) instead of being
# taken from the Node of the base image.
RUN mise use -g node@${NODE_VERSION} \
 && mise install \
 && npm install -g corepack@0.36.0 \
 && corepack enable --install-directory /usr/local/bin

WORKDIR /work
